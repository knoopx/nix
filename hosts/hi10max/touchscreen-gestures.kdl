// Touchscreen gesture recognition tuning + binds for hi10max.
//
// Requires knoopx/niri (configurable touch gestures).
// On upstream niri, gesture nodes are unknown and will fail to parse.

input {
    touchscreen {
        // Pin the absolute touch surface to the built-in eDP display.
        map-to-output "eDP-1"

        // Defer focus to finger-lift; skip focus entirely if touch became a
        // compositor gesture. Plain taps focus on lift.
        focus-on-touch "touch-up"

        gestures {
            // -----------------------------------------------------
            // Swipe tuning
            // -----------------------------------------------------
            swipe-trigger-distance    100.0
            swipe-multi-finger-scale  1.2

            // -----------------------------------------------------
            // Edge swipe tuning
            // -----------------------------------------------------
            edge-start-distance       12.0

            // -----------------------------------------------------
            // Pinch tuning
            // -----------------------------------------------------
            pinch-trigger-distance    100.0
            pinch-dominance-ratio     1.0
            pinch-sensitivity         1.0

            // -----------------------------------------------------
            // Rotation tuning — all angles in DEGREES
            // -----------------------------------------------------
            rotation-trigger-angle    20.0
            rotation-dominance-ratio  0.5

            // -----------------------------------------------------
            // Tap tuning
            // -----------------------------------------------------
            tap-wobble-threshold      15.0
            tap-timeout-ms            500.0

            // -----------------------------------------------------
            // Tap-hold-drag tuning
            // -----------------------------------------------------
            tap-hold-trigger-delay-ms 200.0

            // -----------------------------------------------------
            // Flick-to-throw tuning
            // -----------------------------------------------------
            // flick-to-monitor          true
            // flick-velocity-threshold  800.0
        }
    }
}

binds {
    // =========================================================================
    // Plain touchscreen gestures (no modifier)
    // =========================================================================

    // -------------------------------------------------------------------------
    // Swipe — workspace / column navigation + overview
    // -------------------------------------------------------------------------
    TouchSwipe fingers=3 direction="up"    natural-scroll=true { focus-workspace-up; }
    TouchSwipe fingers=3 direction="down"  natural-scroll=true { focus-workspace-down; }
    TouchSwipe fingers=3 direction="left"  natural-scroll=true { focus-column-right; }
    TouchSwipe fingers=3 direction="right" natural-scroll=true { focus-column-left; }

    TouchSwipe fingers=4 direction="up"    { toggle-overview; }
    TouchSwipe fingers=4 direction="down"  { toggle-overview; }

    // -------------------------------------------------------------------------
    // Pinch — overview toggles
    // -------------------------------------------------------------------------
    TouchPinch fingers=3 direction="in"    { open-overview; }
    TouchPinch fingers=3 direction="out"   { close-overview; }

    TouchPinch fingers=4 direction="in"    { open-overview; }
    TouchPinch fingers=4 direction="out"   { close-overview; }

    // -------------------------------------------------------------------------
    // Rotate — column navigation
    // -------------------------------------------------------------------------
    TouchRotate fingers=4 direction="ccw" { focus-column-left; }
    TouchRotate fingers=4 direction="cw"  { focus-column-right; }

    // -------------------------------------------------------------------------
    // Edge swipes — overview from the top corners and bottom-center.
    // Workspace / column navigation is handled by 3-finger swipes, so the
    // plain top/bottom edge binds are intentionally omitted; the left/right
    // center edges drive Firefox back / forward below.
    // -------------------------------------------------------------------------
    TouchEdge edge="top"    zone="right"  natural-scroll=true { toggle-overview; }
    TouchEdge edge="left"   zone="top"    natural-scroll=true { toggle-overview; }
    // Bottom swipe-up yields a negative delta_y; natural-scroll would invert it
    // to a close, so omit it (natural=false) so swiping up opens the overview.
    TouchEdge edge="bottom" zone="center" { toggle-overview; }

    // -------------------------------------------------------------------------
    // Edge swipes — Firefox back / forward.
    // One-finger edge swipes press Alt then Left/Right (Firefox's default
    // back / forward keys) on the focused window via wtype: -M holds the
    // modifier, -k types the key, and wtype releases modifiers on exit.
    // -------------------------------------------------------------------------
    TouchEdge edge="left"  zone="center" { spawn "wtype" "-M" "alt" "-k" "Left"; }
    TouchEdge edge="right" zone="center" { spawn "wtype" "-M" "alt" "-k" "Right"; }
}
